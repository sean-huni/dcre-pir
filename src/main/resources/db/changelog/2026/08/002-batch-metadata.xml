<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- A-39b: Liquibase-owned copy of the Spring Batch 6.0.4 postgres DDL,
         table-prefixed per service (PIR_BATCH_) for single-writer cleanliness
         (R-34), EXIT_MESSAGE widened to TEXT so CRDB-driver cause chains are
         never truncated.

         LIQUIBASE-SQL-EXCEPTION: this is autogenerated FRAMEWORK DDL owned by
         Spring Batch, not schema this project designs. Hand-transcribing 6 tables
         and 3 sequences (9 CREATE statements) into typed tags would fork the
         framework's own schema and make the next Batch upgrade a manual diff,
         which is the vendor-lock the pure-XML rule exists to prevent, not an
         instance of it. Same precedent as PRR 002, CIR 002 and MRR. Every CREATE
         carries IF NOT EXISTS, so a pod SIGKILLed mid-migration re-runs the file
         safely; that is ALSO why the precondition on this changeset names ALL NINE objects under
         one not/and instead of sampling one of them (A-81: a precondition naming a single
         table reads a half-applied file as complete and skips the rest forever). -->
    <changeSet id="pir-002-batch-metadata" author="dcre">
        <!-- A-82: the fleet's copy of this file gained IF NOT EXISTS after it had
             already been applied, changing the enclosing changeset's checksum. The
             escape hatch is kept here even though pir-002 has never run anywhere,
             so a future edit to the vendored framework DDL cannot fail validation
             on a database that already has PIR history. It is APPLICABILITY that
             must stay preserved for this file, not the byte-for-byte checksum. -->
        <validCheckSum>ANY</validCheckSum>
        <!-- RE-RUN GUARD: marked run only when ALL NINE objects this sqlFile creates are
             already present. A half-applied file therefore still re-runs, and the
             IF NOT EXISTS clause on every CREATE makes that re-run safe. Guarding on a
             single object would reinstate A-81: it reads a half-applied file as complete
             and skips the rest forever. -->
        <preConditions onFail="MARK_RAN">
            <not>
                <and>
                    <tableExists tableName="PIR_BATCH_JOB_INSTANCE"/>
                    <tableExists tableName="PIR_BATCH_JOB_EXECUTION"/>
                    <tableExists tableName="PIR_BATCH_JOB_EXECUTION_PARAMS"/>
                    <tableExists tableName="PIR_BATCH_STEP_EXECUTION"/>
                    <tableExists tableName="PIR_BATCH_STEP_EXECUTION_CONTEXT"/>
                    <tableExists tableName="PIR_BATCH_JOB_EXECUTION_CONTEXT"/>
                    <sequenceExists sequenceName="PIR_BATCH_STEP_EXECUTION_SEQ"/>
                    <sequenceExists sequenceName="PIR_BATCH_JOB_EXECUTION_SEQ"/>
                    <sequenceExists sequenceName="PIR_BATCH_JOB_INSTANCE_SEQ"/>
                </and>
            </not>
        </preConditions>
        <sqlFile path="db/changelog/2026/08/batch-metadata-pir.sql" splitStatements="true"/>
    </changeSet>

</databaseChangeLog>
